# Copy to .env, replace all password placeholders, then follow README.md.
COMPOSE_PROJECT_NAME=irr-development
DB_USER=irr_app
DB_PASSWORD=replace-with-a-random-database-password
DB_NAME=irr
API_PORT=9191
API_DOCS_ENABLED=true
DEV_BOOTSTRAP_ENABLED=true
DEV_ADMIN_NAME=Development Administrator
DEV_ADMIN_EMAIL=developer@irr.local
DEV_ADMIN_PASSWORD=replace-with-a-random-application-password

# Comma-separated browser origins allowed to call the bearer API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Internal Docker Redis credentials; keep real values out of version control.
REDIS_PASSWORD=replace-with-a-random-redis-password

# Explicit local organization seeded once with the development administrator as manager.
DEV_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
DEV_ORGANIZATION_NAME=IRR Development

# Optional first-deployment bootstrap outside the development profile; create-only.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=replace-with-the-first-administrator-name
BOOTSTRAP_ADMIN_EMAIL=replace-with-an-operator-email@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-bootstrap-password

# EXTERNAL CONFIGURATION REQUIRED for Brevo: obtain an approved account, verified sender/domain and private API key.
# Local catcher only; use MAIL_PROVIDER=brevo with verified sender and a private API key on Railway.
MAIL_PROVIDER=mailpit
MAIL_API_KEY=
MAIL_FROM=development@irr.local
MAIL_FROM_NAME=IRR Development
MAILPIT_URL=http://mailpit:8025
MAILPIT_PORT=8025
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_MINUTES=30
