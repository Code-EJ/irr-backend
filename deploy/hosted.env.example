IRR_EDGE_IMAGE=caddy:2-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
IRR_BACKEND_IMAGE=registry.example/irr-backend@sha256:REPLACE_WITH_REVIEWED_DIGEST
IRR_FRONTEND_IMAGE=registry.example/irr-frontend@sha256:REPLACE_WITH_REVIEWED_DIGEST
IRR_POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
IRR_REDIS_IMAGE=redis:8.2-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
